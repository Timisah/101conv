{
  "profile": {
    "schemaVersion": 1,
    "type": "conversion",
    "id": "jpeg-xl-linux-amd64",
    "version": "1.2.0",
    "name": "JPEG XL Image Conversion",
    "description": "Encode JPEG, PNG, APNG, and GIF images as JPEG XL with adjustable quality; decode JPEG XL to JPEG or PNG.",
    "license": "BSD-3-Clause; bundled dependency notices are included in the upstream package.",
    "minimumAppVersion": "0.1.0",
    "maximumAppVersionExclusive": "1.0.0",
    "priority": 45,
    "engines": [{"engineId":"jpeg-xl","versions":{"minimum":"0.12.0","maximumExclusive":"1.0.0"},"capabilities":["image.decode","image.encode"]}],
    "rules": [
      {"engineId":"jpeg-xl","executable":"cjxl","sources":["jpg","jpeg"],"targets":["jxl"],"arguments":["{source}","--lossless_jpeg=0","{target}"]},
      {"engineId":"jpeg-xl","executable":"cjxl","sources":["png","apng","gif"],"targets":["jxl"],"arguments":["{source}","{target}"]},
      {"engineId":"jpeg-xl","executable":"djxl","sources":["jxl"],"targets":["jpg","jpeg","png"],"arguments":["{source}","{target}"]}
    ]
  }
}
