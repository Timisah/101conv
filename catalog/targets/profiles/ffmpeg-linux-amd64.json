{
  "profile": {
    "schemaVersion": 1,
    "id": "ffmpeg-linux-amd64",
    "version": "1.1.0",
    "name": "FFmpeg Audio/Video + Compression",
    "description": "Common audio and video transcoding and target-size compression using a shared FFmpeg engine installation.",
    "license": "LGPL-2.1-or-later for FFmpeg; bundled dependencies have separate terms.",
    "minimumAppVersion": "0.1.0",
    "maximumAppVersionExclusive": "1.0.0",
    "priority": 50,
    "engines": [{"engineId":"ffmpeg","versions":{"minimum":"9.0.0","maximumExclusive":"10.0.0"},"capabilities":["audio.decode","audio.encode","video.decode","video.encode","media.probe"]}],
    "compression": {
      "options": [{"key":"targetSizeMb","label":"Target size (MB)","type":"number","default":"8","min":1,"max":200,"step":1,"targetSizeMb":true}],
      "probeExecutable":"ffprobe",
      "audioBitrateKbps":128,
      "minimumVideoKbps":64,
      "requireSmallerOutput":true
    },
    "rules": [
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp4","mkv","mov","avi","webm","m4v","mpg","mpeg","3gp","flv"],"targets":["mp4","mkv","mov","avi","m4v"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{compression.args}","{target}"],"compressionArguments":["-c:v","mpeg4","-c:a","aac","-b:v","{compression.videoKbps}k","-maxrate","{compression.videoKbps}k","-bufsize","{compression.bufferKbps}k","-b:a","{compression.audioKbps}k"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp4","mkv","mov","avi","webm","m4v","mpg","mpeg","3gp","flv"],"targets":["webm"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{compression.args}","{target}"],"compressionArguments":["-c:v","libvpx-vp9","-c:a","libopus","-b:v","{compression.videoKbps}k","-maxrate","{compression.videoKbps}k","-bufsize","{compression.bufferKbps}k","-b:a","{compression.audioKbps}k"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp4","mkv","mov","avi","webm","m4v","mpg","mpeg","3gp","flv"],"targets":["mpg","mpeg","3gp","flv"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{target}"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp3","aac","m4a","ogg","opus","wav","flac","wma","amr"],"targets":["mp3"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{compression.args}","{target}"],"compressionArguments":["-c:a","libmp3lame","-b:a","{compression.audioKbps}k"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp3","aac","m4a","ogg","opus","wav","flac","wma","amr"],"targets":["aac","m4a"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{compression.args}","{target}"],"compressionArguments":["-c:a","aac","-b:a","{compression.audioKbps}k"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp3","aac","m4a","ogg","opus","wav","flac","wma","amr"],"targets":["ogg"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{compression.args}","{target}"],"compressionArguments":["-c:a","libvorbis","-b:a","{compression.audioKbps}k"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp3","aac","m4a","ogg","opus","wav","flac","wma","amr"],"targets":["opus"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{compression.args}","{target}"],"compressionArguments":["-c:a","libopus","-b:a","{compression.audioKbps}k"]},
      {"engineId":"ffmpeg","executable":"ffmpeg","sources":["mp3","aac","m4a","ogg","opus","wav","flac","wma","amr"],"targets":["wav","flac","wma","amr"],"arguments":["-hide_banner","-loglevel","error","-nostdin","-y","-i","{source}","{target}"]}
    ]
  }
}
