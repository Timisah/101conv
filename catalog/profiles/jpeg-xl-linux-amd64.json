{
  "schemaVersion": 1,
  "id": "jpeg-xl-linux-amd64",
  "version": "0.12.0",
  "name": "JPEG XL (Linux x86-64)",
  "description": "Official static JPEG XL tools for converting JPEG, PNG, APNG, and GIF images to JXL and decoding JXL to JPEG or PNG.",
  "author": "JPEG XL Project",
  "license": "BSD-3-Clause; bundled dependency notices are included in the package",
  "homepage": "https://github.com/libjxl/libjxl",
  "minimumAppVersion": "0.0.1",
  "maximumAppVersionExclusive": "0.2.0",
  "artifact": {
    "url": "https://github.com/libjxl/libjxl/releases/download/v0.12.0/jxl-linux-x86_64-static.tar.lz",
    "sha256": "5318a1ea40adad76d023e0c17a03d4627f8282f83cb2b575e69be8e74f1ff456",
    "format": "tar.lz",
    "platform": "linux-amd64",
    "executable": "tools/cjxl",
    "executables": {
      "djxl": "tools/djxl"
    }
  },
  "converter": {
    "id": "jpeg-xl",
    "friendlyName": "JPEG XL",
    "priority": 45,
    "rules": [
      {
        "sources": ["jpeg", "jpg", "png", "apng", "gif"],
        "targets": ["jxl"],
        "command": ["{var:executable}", "{source}", "{target}", "-q", "85"]
      },
      {
        "sources": ["jxl"],
        "targets": ["jpeg", "jpg", "png"],
        "command": ["{var:djxl}", "{source}", "{target}"]
      }
    ]
  }
}
